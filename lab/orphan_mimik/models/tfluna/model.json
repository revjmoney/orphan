{
  "name": "TF-Luna",
  "bus": "i2c",
  "engine": "i2c-target",
  "family": "distance",
  "description": "Benewake TF-Luna LiDAR (time of flight) in I2C mode: distance, signal strength and chip temperature",
  "config": {
    "write_cycle_us": 0,
    "wp": false,
    "address_bytes": 1,
    "address": "0x10",
    "address_mask": "0x7f",
    "size": 64,
    "page": 64,
    "register_width": 1
  },
  "fill": 0,
  "controls": [
    {
      "id": "distance",
      "label": "Distance",
      "unit": "cm",
      "min": 20,
      "max": 800,
      "step": 1,
      "default": 150
    },
    {
      "id": "amp",
      "label": "Signal strength",
      "unit": "",
      "min": 0,
      "max": 30000,
      "step": 1,
      "default": 2000
    },
    {
      "id": "temp",
      "label": "Chip temperature",
      "unit": "C",
      "min": -10,
      "max": 60,
      "step": 0.01,
      "default": 30
    }
  ],
  "pins": {
    "SCL": "SCL",
    "SDA": "SDA",
    "GND": "GND"
  },
  "tested": "simulation of the engine; on the board through the real I2C pads with the board's I2C master",
  "author": "Rev. J. Money / JMSCNC",
  "licence": "GPL-3.0-or-later"
}