{
  "name": "HMC5883L",
  "bus": "i2c",
  "engine": "i2c-target",
  "family": "compass",
  "description": "Honeywell HMC5883L 3-axis magnetometer (digital compass): 12-bit, X Z Y order, ID \"H43\"",
  "config": {
    "write_cycle_us": 0,
    "wp": false,
    "address_bytes": 1,
    "address": "0x1e",
    "address_mask": "0x7f",
    "size": 16,
    "page": 16,
    "register_width": 1
  },
  "fill": 0,
  "controls": [
    {
      "id": "heading",
      "label": "Heading",
      "unit": "deg",
      "min": 0,
      "max": 360,
      "step": 0.1,
      "default": 90
    },
    {
      "id": "field",
      "label": "Field strength",
      "unit": "gauss",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.5
    },
    {
      "id": "dip",
      "label": "Inclination (dip)",
      "unit": "deg",
      "min": -90,
      "max": 90,
      "step": 0.5,
      "default": 60
    }
  ],
  "pins": {
    "SCL": "SCL",
    "SDA": "SDA",
    "GND": "GND"
  },
  "tested": "simulation of the engine; on the board through the real I2C pads with the board's I2C master",
  "author": "Rev. J. Money / JMSCNC",
  "licence": "GPL-3.0-or-later"
}