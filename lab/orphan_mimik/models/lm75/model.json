{
  "name": "LM75",
  "bus": "i2c",
  "engine": "i2c-target",
  "family": "temperature",
  "description": "LM75 / LM75A digital temperature sensor: 9-bit, 0.5 C per count, 16-bit registers",
  "config": {
    "write_cycle_us": 0,
    "wp": false,
    "address_bytes": 1,
    "address": "0x48",
    "address_mask": "0x7f",
    "size": 8,
    "page": 8,
    "register_width": 2
  },
  "fill": 0,
  "controls": [
    {
      "id": "temp",
      "label": "Temperature",
      "unit": "C",
      "min": -55,
      "max": 125,
      "step": 0.5,
      "default": 22.5
    }
  ],
  "pins": {
    "SCL": "SCL",
    "SDA": "SDA",
    "GND": "GND"
  },
  "tested": "simulation of the engine; on the board through the real I2C pads with the board's I2C master",
  "author": "Rev. J. Money / JMSCNC",
  "licence": "GPL-3.0-or-later"
}