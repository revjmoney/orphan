# [orphan] MIMIK: all 36 hashboard header pins J1..J9 (connector pins 5, 11, 12, 15 of each) -> hdr[0..35],
#   hdr[4*(n-1) + k] = Jn pin (5, 11, 12, 15)[k]. MIMIK picks its SCL / SDA from these (open drain).
# 3.3 V only, NOT 5 V tolerant. The board has no pull-ups on these pins (measured 2026-11-22 on board 2 with weak FPGA pull-downs: every pin on J1, J2, J4, J5, J6, J7 read 0, so no board pull-up);
# PULLTYPE PULLUP below turns on the FPGA's weak pull-ups so an open input reads 1.
set_property -dict {PACKAGE_PIN T11 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[0]}]
set_property -dict {PACKAGE_PIN T12 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[1]}]
set_property -dict {PACKAGE_PIN U12 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[2]}]
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[3]}]
set_property -dict {PACKAGE_PIN R19 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[4]}]
set_property -dict {PACKAGE_PIN V12 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[5]}]
set_property -dict {PACKAGE_PIN W13 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[6]}]
set_property -dict {PACKAGE_PIN V13 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[7]}]
set_property -dict {PACKAGE_PIN T14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[8]}]
set_property -dict {PACKAGE_PIN P14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[9]}]
set_property -dict {PACKAGE_PIN R14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[10]}]
set_property -dict {PACKAGE_PIN T15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[11]}]
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[12]}]
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[13]}]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[14]}]
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[15]}]
set_property -dict {PACKAGE_PIN T16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[16]}]
set_property -dict {PACKAGE_PIN V15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[17]}]
set_property -dict {PACKAGE_PIN W15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[18]}]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[19]}]
set_property -dict {PACKAGE_PIN U14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[20]}]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[21]}]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[22]}]
set_property -dict {PACKAGE_PIN U15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[23]}]
set_property -dict {PACKAGE_PIN T20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[24]}]
set_property -dict {PACKAGE_PIN V20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[25]}]
set_property -dict {PACKAGE_PIN W20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[26]}]
set_property -dict {PACKAGE_PIN U20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[27]}]
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[28]}]
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[29]}]
set_property -dict {PACKAGE_PIN W16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[30]}]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[31]}]
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[32]}]
set_property -dict {PACKAGE_PIN T17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[33]}]
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[34]}]
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {hdr[35]}]
set_property -dict {PACKAGE_PIN F16 IOSTANDARD LVCMOS33} [get_ports {leds[0]}]
set_property -dict {PACKAGE_PIN L19 IOSTANDARD LVCMOS33} [get_ports {leds[1]}]
set_property -dict {PACKAGE_PIN M19 IOSTANDARD LVCMOS33} [get_ports {leds[2]}]
set_property -dict {PACKAGE_PIN M17 IOSTANDARD LVCMOS33} [get_ports {leds[3]}]
# orphan_fan
set_property -dict {PACKAGE_PIN J18 IOSTANDARD LVCMOS33} [get_ports {fan_pwm}]
set_property -dict {PACKAGE_PIN F19 IOSTANDARD LVCMOS33} [get_ports {fan_tach[0]}]
set_property -dict {PACKAGE_PIN G18 IOSTANDARD LVCMOS33} [get_ports {fan_tach[1]}]
set_property -dict {PACKAGE_PIN F20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[2]}]
set_property -dict {PACKAGE_PIN J20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[3]}]
set_property -dict {PACKAGE_PIN G17 IOSTANDARD LVCMOS33} [get_ports {fan_tach[4]}]
set_property -dict {PACKAGE_PIN H20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[5]}]
# the board's own I2C bus (1 kohm pull-ups on the board; pins 3 / 4 of J1..J8), as in Ardzy's 05_spi_i2c
set_property -dict {PACKAGE_PIN W18 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {i2c_scl}]
set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {i2c_sda}]
