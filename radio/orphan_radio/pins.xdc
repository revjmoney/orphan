# J8 (hashboard connector): pin 12 receiver input, pin 5 test transmitter, pin 15 RC feedback
set_property -dict {PACKAGE_PIN W16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {rx_io}]
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {tx_out}]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33} [get_ports {fb_out}]
set_property PACKAGE_PIN T14 [get_ports {mclk}]
set_property IOSTANDARD LVCMOS33 [get_ports {mclk}]
set_property PACKAGE_PIN P14 [get_ports {bclk}]
set_property IOSTANDARD LVCMOS33 [get_ports {bclk}]
set_property PACKAGE_PIN R14 [get_ports {dout}]
set_property IOSTANDARD LVCMOS33 [get_ports {dout}]
set_property PACKAGE_PIN T15 [get_ports {lrclk}]
set_property IOSTANDARD LVCMOS33 [get_ports {lrclk}]
set_property PACKAGE_PIN F16 [get_ports {leds[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[0]}]
set_property PACKAGE_PIN L19 [get_ports {leds[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[1]}]
set_property PACKAGE_PIN M19 [get_ports {leds[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[2]}]
set_property PACKAGE_PIN M17 [get_ports {leds[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[3]}]
# orphan_fan pins: append to every Orphan project's pins.xdc
set_property -dict {PACKAGE_PIN J18 IOSTANDARD LVCMOS33} [get_ports {fan_pwm}]
set_property -dict {PACKAGE_PIN F19 IOSTANDARD LVCMOS33} [get_ports {fan_tach[0]}]
set_property -dict {PACKAGE_PIN G18 IOSTANDARD LVCMOS33} [get_ports {fan_tach[1]}]
set_property -dict {PACKAGE_PIN F20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[2]}]
set_property -dict {PACKAGE_PIN J20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[3]}]
set_property -dict {PACKAGE_PIN G17 IOSTANDARD LVCMOS33} [get_ports {fan_tach[4]}]
set_property -dict {PACKAGE_PIN H20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[5]}]
