set_property PACKAGE_PIN F16 [get_ports {leds[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[0]}]
set_property PACKAGE_PIN L19 [get_ports {leds[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[1]}]
set_property PACKAGE_PIN M19 [get_ports {leds[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[2]}]
set_property PACKAGE_PIN M17 [get_ports {leds[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[3]}]
# orphan_fan pins: append to every Orphan project's pins.xdc
set_property -dict {PACKAGE_PIN J18 IOSTANDARD LVCMOS33} [get_ports {fan_pwm}]
set_property -dict {PACKAGE_PIN F19 IOSTANDARD LVCMOS33} [get_ports {fan_tach[0]}]
set_property -dict {PACKAGE_PIN G18 IOSTANDARD LVCMOS33} [get_ports {fan_tach[1]}]
set_property -dict {PACKAGE_PIN F20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[2]}]
set_property -dict {PACKAGE_PIN J20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[3]}]
set_property -dict {PACKAGE_PIN G17 IOSTANDARD LVCMOS33} [get_ports {fan_tach[4]}]
set_property -dict {PACKAGE_PIN H20 IOSTANDARD LVCMOS33} [get_ports {fan_tach[5]}]
# real NES pads (orphan_nespad.v) on any hashboard connector J1..J9 (pins 5 PLUG, 11 TXD, 12 RXD, 15 RST),
# from S9_PINMAP.md. 3.3 V only, NOT 5 V tolerant: power the pad from the connector's pin 16 (3.3 V).
# The board has no pull-ups on these lines: PULLTYPE PULLUP keeps every unused pin at a defined level.
set_property -dict {PACKAGE_PIN T11 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[0]}]
set_property -dict {PACKAGE_PIN T12 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[0]}]
set_property -dict {PACKAGE_PIN U12 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[0]}]
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[0]}]
set_property -dict {PACKAGE_PIN R19 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[1]}]
set_property -dict {PACKAGE_PIN V12 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[1]}]
set_property -dict {PACKAGE_PIN W13 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[1]}]
set_property -dict {PACKAGE_PIN V13 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[1]}]
set_property -dict {PACKAGE_PIN T14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[2]}]
set_property -dict {PACKAGE_PIN P14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[2]}]
set_property -dict {PACKAGE_PIN R14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[2]}]
set_property -dict {PACKAGE_PIN T15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[2]}]
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[3]}]
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[3]}]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[3]}]
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[3]}]
set_property -dict {PACKAGE_PIN T16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[4]}]
set_property -dict {PACKAGE_PIN V15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[4]}]
set_property -dict {PACKAGE_PIN W15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[4]}]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[4]}]
set_property -dict {PACKAGE_PIN U14 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[5]}]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[5]}]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[5]}]
set_property -dict {PACKAGE_PIN U15 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[5]}]
set_property -dict {PACKAGE_PIN T20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[6]}]
set_property -dict {PACKAGE_PIN V20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[6]}]
set_property -dict {PACKAGE_PIN W20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[6]}]
set_property -dict {PACKAGE_PIN U20 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[6]}]
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[7]}]
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[7]}]
set_property -dict {PACKAGE_PIN W16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[7]}]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[7]}]
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_plug[8]}]
set_property -dict {PACKAGE_PIN T17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_txd[8]}]
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rxd[8]}]
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33 PULLTYPE PULLUP} [get_ports {j_rst[8]}]
# the Game Boy clocks: 33.57 MHz (MMCM) and 4.1958 MHz (that / 8 on a BUFG)
create_clock -period 29.8 [get_nets u_gb.c33]
create_clock -period 238.3 [get_nets u_gb.gclk]
